<View>
  <Header value="Manual QA (Human View)" />

  <View style="padding:10px;border:1px solid #ddd;margin-bottom:10px;">
    <Header value="job_indexed_id" />
    <Text name="job_indexed_id" value="$job_indexed_id" />
    <Header value="title_clean" />
    <Text name="title_clean" value="$title_clean" />
    <Header value="url" />
    <Text name="url" value="$url" />
    <Header value="Quick check (current values)" />
    <Text name="quick_title" value="normalized_title=$gold_normalized_title | role_family=$gold_role_family" />
    <Text name="quick_loc" value="location_type=$gold_location_type | city=$gold_location_city | country=$gold_country" />
    <Text name="quick_job" value="employment=$gold_employment_type | seniority=$gold_seniority" />
    <Text name="quick_salary" value="salary_min=$gold_salary_min | salary_max=$gold_salary_max | currency=$gold_salary_currency | period=$gold_salary_period" />
  </View>

  <View style="padding:10px;border:1px solid #ddd;margin-bottom:10px;max-height:320px;overflow:auto;background:#fafafa;">
    <Header value="Description" />
    <Text name="desc" value="$description_for_qa" />
  </View>

  <View style="display:flex;gap:16px;">
    <View style="flex:1;padding:10px;border:1px solid #ddd;">
      <Header value="Current (gold)" />

      <Header value="gold_normalized_title" />
      <Text name="gold_normalized_title" value="$gold_normalized_title" />

      <Header value="gold_role_family" />
      <Text name="gold_role_family" value="$gold_role_family" />

      <Header value="gold_location_type" />
      <Text name="gold_location_type" value="$gold_location_type" />

      <Header value="gold_location_city" />
      <Text name="gold_location_city" value="$gold_location_city" />

      <Header value="gold_country" />
      <Text name="gold_country" value="$gold_country" />

      <Header value="gold_employment_type" />
      <Text name="gold_employment_type" value="$gold_employment_type" />

      <Header value="gold_seniority" />
      <Text name="gold_seniority" value="$gold_seniority" />

      <Header value="gold_salary_min" />
      <Text name="gold_salary_min" value="$gold_salary_min" />

      <Header value="gold_salary_max" />
      <Text name="gold_salary_max" value="$gold_salary_max" />

      <Header value="gold_salary_currency" />
      <Text name="gold_salary_currency" value="$gold_salary_currency" />

      <Header value="gold_salary_period" />
      <Text name="gold_salary_period" value="$gold_salary_period" />
    </View>

    <View style="flex:1;padding:10px;border:1px solid #ddd;">
      <Header value="Fix (qa_fix_*)" />

      <Header value="qa_status" />
      <Choices name="qa_status" toName="desc" choice="single" showInline="true">
        <Choice value="ok" />
        <Choice value="fix" />
        <Choice value="unsure" />
      </Choices>

      <Header value="qa_fix_location_type" />
      <Choices name="qa_fix_location_type" toName="desc" choice="single" showInline="true">
        <Choice value="__NO_CHANGE__" alias="(no change)" />
        <Choice value="remote" />
        <Choice value="hybrid" />
        <Choice value="onsite" />
        <Choice value="unspecified" />
      </Choices>

      <Header value="qa_fix_location_city" />
      <TextArea name="qa_fix_location_city" toName="desc" rows="1" placeholder="Chicago" />

      <Header value="qa_fix_country" />
      <TextArea name="qa_fix_country" toName="desc" rows="1" placeholder="US" />

      <Header value="qa_fix_employment_type" />
      <Choices name="qa_fix_employment_type" toName="desc" choice="single" showInline="true">
        <Choice value="__NO_CHANGE__" alias="(no change)" />
        <Choice value="full_time" />
        <Choice value="part_time" />
        <Choice value="contract" />
        <Choice value="internship" />
        <Choice value="temporary" />
        <Choice value="unspecified" />
      </Choices>

      <Header value="qa_fix_seniority" />
      <Choices name="qa_fix_seniority" toName="desc" choice="single" showInline="true">
        <Choice value="__NO_CHANGE__" alias="(no change)" />
        <Choice value="intern" />
        <Choice value="junior" />
        <Choice value="mid" />
        <Choice value="senior" />
        <Choice value="lead" />
        <Choice value="manager" />
        <Choice value="director" />
        <Choice value="executive" />
        <Choice value="unspecified" />
      </Choices>

      <Header value="qa_fix_salary_min" />
      <TextArea name="qa_fix_salary_min" toName="desc" rows="1" placeholder="136000" />

      <Header value="qa_fix_salary_max" />
      <TextArea name="qa_fix_salary_max" toName="desc" rows="1" placeholder="160000" />

      <Header value="qa_fix_salary_currency" />
      <TextArea name="qa_fix_salary_currency" toName="desc" rows="1" placeholder="USD" />

      <Header value="qa_fix_salary_period" />
      <Choices name="qa_fix_salary_period" toName="desc" choice="single" showInline="true">
        <Choice value="__NO_CHANGE__" alias="(no change)" />
        <Choice value="hourly" />
        <Choice value="daily" />
        <Choice value="weekly" />
        <Choice value="monthly" />
        <Choice value="yearly" />
        <Choice value="unspecified" />
      </Choices>

      <Header value="qa_notes" />
      <TextArea name="qa_notes" toName="desc" rows="2" placeholder="note" />
    </View>
  </View>
</View>
